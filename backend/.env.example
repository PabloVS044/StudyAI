# =============================================================================
# StudyAI - Variables de entorno del backend
# Copia este archivo a backend/.env y rellena los valores reales.
# NUNCA subas el .env real a git.
# =============================================================================


# --- OBLIGATORIAS -----------------------------------------------------------
# Sin estas variables el backend no arranca correctamente.

# Supabase: URL del proyecto y clave de servicio (con permisos de escritura)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXXXXXXXX

# Clerk: URL del JWKS de tu aplicacion Clerk (para verificar JWTs del frontend)
# Formato: https://<tu-dominio>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://tu-dominio.clerk.accounts.dev/.well-known/jwks.json

# Mistral: clave de API para embeddings y generacion de texto
MISTRAL_API_KEY=tu_mistral_api_key_aqui

# Pinecone: clave de API y nombre del indice (dimension=1024, metric=cosine)
PINECONE_API_KEY=tu_pinecone_api_key_aqui
PINECONE_INDEX_NAME=studyai-notes


# --- SERVIDOR ---------------------------------------------------------------

# Origenes CORS permitidos (separados por coma, sin espacios)
# En desarrollo agrega http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Directorio donde se guardan los archivos subidos por el usuario
UPLOADS_DIR=uploads


# --- OPCIONALES: Notion OAuth (por usuario) ----------------------------------
# Requiere una integracion Publica en notion.so/my-integrations.
# NOTA: Notion redirige directamente a la pagina /integrations del FRONTEND
#       (patron frontend-callback). El backend recibe el code via POST /notion/exchange.
# NOTION_OAUTH_CLIENT_ID  -> "OAuth client ID" de la integracion Public de Notion.
# NOTION_OAUTH_CLIENT_SECRET -> "OAuth client secret" (NO el internal integration token).
# NOTION_REDIRECT_URI     -> URL de la pagina /integrations del frontend (HTTPS obligatorio).
#                            Debe coincidir exactamente con la registrada en Notion.
# FRONTEND_URL            -> Dominio raiz del frontend (usado en CORS y redirects).
# Deja en blanco si no usas la integracion con Notion.

NOTION_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_OAUTH_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REDIRECT_URI=https://tu-dominio.vercel.app/integrations


# --- OPCIONALES: Google Drive OAuth (por usuario) ---------------------------
# Crea credenciales OAuth "Aplicacion web" en Google Cloud Console.
# GOOGLE_REDIRECT_URI DEBE apuntar a /api/integrations/google/callback.
# Deja en blanco si no usas la integracion con Google Drive.

GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback


# --- URL del frontend -------------------------------------------------------
# Dominio raiz del frontend. Usar en CORS_ORIGINS y redirects OAuth.
# En produccion pon la URL publica de Vercel (sin trailing slash).
FRONTEND_URL=https://tu-dominio.vercel.app


# --- OPCIONALES: Obsidian ---------------------------------------------------
# Ruta absoluta al vault de Obsidian en la maquina donde corre el backend.
# Deja en blanco si no usas esta integracion.

OBSIDIAN_VAULT_PATH=/ruta/absoluta/a/tu/vault
