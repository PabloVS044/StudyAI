# =============================================================================
# StudyAI - Variables de entorno RAIZ (usadas por docker-compose)
# Copia este archivo a .env en la raiz del proyecto y rellena los valores.
# NUNCA subas el .env real a git.
#
# docker-compose lee este archivo y pasa VITE_CLERK_PUBLISHABLE_KEY como
# build-arg al contenedor del frontend en tiempo de build.
# =============================================================================

# Clave publica de tu aplicacion Clerk (empieza con pk_test_ o pk_live_)
# Esta misma variable va en frontend/.env para desarrollo local.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
