# =============================================================================
# StudyAI - Variables de entorno del frontend
# Copia este archivo a frontend/.env y rellena los valores reales.
# NUNCA subas el .env real a git.
# =============================================================================

# URL base de la API del backend.
# En desarrollo apunta al backend local; en Docker deja vacio (mismo origen).
# Desarrollo local: http://localhost:8000
# Docker (mismo origen, nginx proxea /api): dejar vacio o ""
VITE_API_URL=

# Clave publica de tu aplicacion Clerk (empieza con pk_test_ o pk_live_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
